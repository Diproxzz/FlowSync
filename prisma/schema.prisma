datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProductSource {
  MASTER
  INVOICE_AUTO
  MANUAL
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
}

enum MovementSource {
  SEED_OPENING
  INVOICE
  MANUAL
  LEGACY_XLSX
}

model Product {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  category          String?
  default_hsn       String?
  pack_size_kg      Decimal?        @db.Decimal(8, 2)
  std_purchase_rate Decimal?        @db.Decimal(10, 2)
  std_sale_rate     Decimal?        @db.Decimal(10, 2)
  reorder_level_kg  Decimal?        @db.Decimal(12, 3)
  is_active         Boolean         @default(true)
  needs_review      Boolean         @default(false)
  source            ProductSource   @default(MASTER)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  aliases           ProductAlias[]
  invoice_items     InvoiceItem[]
  stock_movements   StockMovement[]

  @@map("products")
}

model ProductAlias {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  alias      String
  alias_norm String   @unique
  created_at DateTime @default(now())

  @@map("product_aliases")
}

model Customer {
  id         String            @id @default(cuid())
  name       String
  name_norm  String
  gstin      String?           @unique
  address    String?
  state_code String?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  aliases    CustomerAlias[]
  invoices   Invoice[]

  @@map("customers")
}

model CustomerAlias {
  id          String   @id @default(cuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  alias       String
  alias_norm  String   @unique
  created_at  DateTime @default(now())

  @@map("customer_aliases")
}

model Invoice {
  id                      String            @id @default(cuid())
  invoice_number          String
  invoice_number_norm     String            @unique
  invoice_date            DateTime          @db.Date
  financial_year          String
  customer_id             String
  customer                Customer          @relation(fields: [customer_id], references: [id])
  customer_name_snapshot  String
  customer_gstin_snapshot String?
  taxable_total           Decimal           @db.Decimal(14, 2)
  cgst_total              Decimal           @db.Decimal(14, 2)
  sgst_total              Decimal           @db.Decimal(14, 2)
  igst_total              Decimal           @default(0) @db.Decimal(14, 2)
  round_off               Decimal           @db.Decimal(6, 2)
  grand_total             Decimal           @db.Decimal(14, 2)
  source_file_hash        String
  source_file_key         String?
  extraction_provider     String?
  extraction_model        String?
  warnings                Json?
  version                 Int               @default(1)
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  items                   InvoiceItem[]
  revisions               InvoiceRevision[]

  @@index([invoice_date])
  @@index([customer_id, invoice_date])
  @@index([financial_year])
  @@map("invoices")
}

model InvoiceItem {
  id               String         @id @default(cuid())
  invoice_id       String
  invoice          Invoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  line_no          Int
  product_id       String
  product          Product        @relation(fields: [product_id], references: [id])
  product_name_raw String
  hsn              String?
  qty_kg           Decimal        @db.Decimal(12, 3)
  pack_size_kg     Decimal?       @db.Decimal(8, 2)
  rate             Decimal        @db.Decimal(10, 2)
  taxable_amount   Decimal        @db.Decimal(14, 2)
  cgst_pct         Decimal        @db.Decimal(5, 2)
  sgst_pct         Decimal        @db.Decimal(5, 2)
  igst_pct         Decimal        @default(0) @db.Decimal(5, 2)
  cgst_amount      Decimal        @db.Decimal(14, 2)
  sgst_amount      Decimal        @db.Decimal(14, 2)
  igst_amount      Decimal        @default(0) @db.Decimal(14, 2)
  line_total       Decimal        @db.Decimal(14, 2)

  movement         StockMovement?

  @@unique([invoice_id, line_no])
  @@index([product_id])
  @@map("invoice_items")
}

model InvoiceRevision {
  id         String   @id @default(cuid())
  invoice_id String
  invoice    Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  reason     String
  changed_at DateTime @default(now())

  @@map("invoice_revisions")
}

model StockMovement {
  id              String         @id @default(cuid())
  product_id      String
  product         Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  movement_date   DateTime       @db.Date
  type            MovementType
  qty_kg          Decimal        @db.Decimal(12, 3)
  invoice_item_id String?        @unique
  invoice_item    InvoiceItem?   @relation(fields: [invoice_item_id], references: [id], onDelete: Cascade)
  source          MovementSource
  party_text      String?
  note            String?
  created_at      DateTime       @default(now())

  @@index([product_id, movement_date])
  @@map("stock_movements")
}

model ExtractionLog {
  id           String   @id @default(cuid())
  file_hash    String
  provider     String
  model        String
  latency_ms   Int
  status       String
  attempts     Int
  raw_response Json?
  validation   Json?
  created_at   DateTime @default(now())

  @@map("extraction_logs")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}
