datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProductSource {
  MASTER
  INVOICE_AUTO
  MANUAL
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
}

enum MovementSource {
  SEED_OPENING
  INVOICE
  MANUAL
  LEGACY_XLSX
  PURCHASE_INVOICE
  INFORMAL_INVOICE
}

enum DocumentType {
  SALES
  PURCHASE
}

model Product {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  category          String?
  default_hsn       String?
  pack_size_kg      Decimal?        @db.Decimal(8, 2)
  std_purchase_rate Decimal?        @db.Decimal(10, 2)
  landing_cost      Decimal?        @db.Decimal(10, 2)
  std_sale_rate     Decimal?        @db.Decimal(10, 2)
  reorder_level_kg  Decimal?        @db.Decimal(12, 3)
  is_active         Boolean         @default(true)
  needs_review      Boolean         @default(false)
  source            ProductSource   @default(MASTER)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  aliases           ProductAlias[]
  invoice_items     InvoiceItem[]
  purchase_items    PurchaseInvoiceItem[]
  informal_items    InformalInvoiceItem[]
  stock_movements   StockMovement[]

  @@map("products")
}

model ProductAlias {
  id         String   @id @default(cuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  alias      String
  alias_norm String   @unique
  created_at DateTime @default(now())

  @@map("product_aliases")
}

model Customer {
  id         String            @id @default(cuid())
  name       String
  name_norm  String
  gstin      String?           @unique
  address        String?
  state_code     String?
  gstin_source   String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  aliases                 CustomerAlias[]
  invoices                Invoice[]
  informal_invoices       InformalInvoice[]
  ledger_account          LedgerAccount?          @relation("CustomerRegularLedger")
  informal_ledger_account LedgerAccount?          @relation("CustomerInformalLedger")

  @@map("customers")
}

model CustomerAlias {
  id          String   @id @default(cuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  alias       String
  alias_norm  String   @unique
  created_at  DateTime @default(now())

  @@map("customer_aliases")
}

model Invoice {
  id                      String            @id @default(cuid())
  invoice_number          String
  invoice_number_norm     String            @unique
  invoice_date            DateTime          @db.Date
  financial_year          String
  customer_id             String
  customer                Customer          @relation(fields: [customer_id], references: [id])
  customer_name_snapshot  String
  customer_gstin_snapshot String?
  taxable_total           Decimal           @db.Decimal(14, 2)
  discount_total          Decimal?          @db.Decimal(14, 2)
  discount_pct            Decimal?          @db.Decimal(5, 2)
  cgst_total              Decimal           @db.Decimal(14, 2)
  sgst_total              Decimal           @db.Decimal(14, 2)
  igst_total              Decimal           @default(0) @db.Decimal(14, 2)
  round_off               Decimal           @db.Decimal(6, 2)
  grand_total             Decimal           @db.Decimal(14, 2)
  source_file_hash        String
  source_file_key         String?
  extraction_provider     String?
  extraction_model        String?
  warnings                Json?
  version                 Int               @default(1)
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  items                   InvoiceItem[]
  revisions               InvoiceRevision[]
  ledger_entry            LedgerEntry?

  @@index([invoice_date])
  @@index([customer_id, invoice_date])
  @@index([financial_year])
  @@map("invoices")
}

model InvoiceItem {
  id               String         @id @default(cuid())
  invoice_id       String
  invoice          Invoice        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  line_no          Int
  product_id       String
  product          Product        @relation(fields: [product_id], references: [id])
  product_name_raw String
  hsn              String?
  qty_kg           Decimal        @db.Decimal(12, 3)
  pack_size_kg     Decimal?       @db.Decimal(8, 2)
  rate             Decimal        @db.Decimal(10, 2)
  discount_pct     Decimal?       @db.Decimal(5, 2)
  discount_amount  Decimal?       @db.Decimal(14, 2)
  taxable_amount   Decimal        @db.Decimal(14, 2)
  cgst_pct         Decimal        @db.Decimal(5, 2)
  sgst_pct         Decimal        @db.Decimal(5, 2)
  igst_pct         Decimal        @default(0) @db.Decimal(5, 2)
  cgst_amount      Decimal        @db.Decimal(14, 2)
  sgst_amount      Decimal        @db.Decimal(14, 2)
  igst_amount      Decimal        @default(0) @db.Decimal(14, 2)
  line_total       Decimal        @db.Decimal(14, 2)

  movement         StockMovement?

  @@unique([invoice_id, line_no])
  @@index([product_id])
  @@map("invoice_items")
}

model InvoiceRevision {
  id         String   @id @default(cuid())
  invoice_id String
  invoice    Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  reason     String
  changed_at DateTime @default(now())

  @@map("invoice_revisions")
}

model StockMovement {
  id                       String               @id @default(cuid())
  product_id               String
  product                  Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  movement_date            DateTime             @db.Date
  type                     MovementType
  qty_kg                   Decimal              @db.Decimal(12, 3)
  invoice_item_id          String?              @unique
  invoice_item             InvoiceItem?         @relation(fields: [invoice_item_id], references: [id], onDelete: Cascade)
  purchase_invoice_item_id String?              @unique
  purchase_invoice_item    PurchaseInvoiceItem? @relation(fields: [purchase_invoice_item_id], references: [id], onDelete: Cascade)
  informal_invoice_item_id String?              @unique
  informal_invoice_item    InformalInvoiceItem? @relation(fields: [informal_invoice_item_id], references: [id], onDelete: Cascade)
  source                   MovementSource
  party_text               String?
  note                     String?
  created_at               DateTime             @default(now())

  @@index([product_id, movement_date])
  @@map("stock_movements")
}

model ExtractionLog {
  id            String       @id @default(cuid())
  document_type DocumentType @default(SALES)
  file_hash     String
  provider      String
  model         String
  latency_ms    Int
  status        String
  attempts      Int
  raw_response  Json?
  validation    Json?
  created_at    DateTime     @default(now())

  @@map("extraction_logs")
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  name_norm  String
  gstin      String?  @unique
  address        String?
  state_code     String?
  gstin_source   String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  aliases           SupplierAlias[]
  purchase_invoices PurchaseInvoice[]
  ledger_account    LedgerAccount?

  @@map("suppliers")
}

model SupplierAlias {
  id          String   @id @default(cuid())
  supplier_id String
  supplier    Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  alias       String
  alias_norm  String   @unique
  created_at  DateTime @default(now())

  @@map("supplier_aliases")
}

model PurchaseInvoice {
  id                      String                    @id @default(cuid())
  supplier_invoice_number String
  invoice_number_norm     String
  invoice_date            DateTime                  @db.Date
  received_date           DateTime?                 @db.Date
  financial_year          String
  supplier_id             String
  supplier                Supplier                  @relation(fields: [supplier_id], references: [id])
  supplier_name_snapshot  String
  supplier_gstin_snapshot String?
  is_import               Boolean                   @default(false)
  buyer_gstin_snapshot    String?
  reference_no            String?
  vehicle_no              String?
  taxable_total           Decimal                   @db.Decimal(14, 2)
  cgst_total              Decimal                   @db.Decimal(14, 2)
  sgst_total              Decimal                   @db.Decimal(14, 2)
  igst_total              Decimal                   @default(0) @db.Decimal(14, 2)
  other_charges           Decimal                   @default(0) @db.Decimal(14, 2)
  tcs                     Decimal                   @default(0) @db.Decimal(14, 2)
  round_off               Decimal                   @db.Decimal(6, 2)
  grand_total             Decimal                   @db.Decimal(14, 2)
  source_file_hash        String
  source_file_key         String?
  extraction_provider     String?
  extraction_model        String?
  warnings                Json?
  version                 Int                       @default(1)
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt

  items                   PurchaseInvoiceItem[]
  revisions               PurchaseInvoiceRevision[]
  ledger_entry            LedgerEntry?

  @@unique([supplier_id, invoice_number_norm])
  @@index([invoice_date])
  @@index([supplier_id, invoice_date])
  @@index([financial_year])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                  String           @id @default(cuid())
  purchase_invoice_id String
  purchase_invoice    PurchaseInvoice  @relation(fields: [purchase_invoice_id], references: [id], onDelete: Cascade)
  line_no             Int
  product_id          String
  product             Product          @relation(fields: [product_id], references: [id])
  product_name_raw    String
  hsn                 String?
  qty_printed         Decimal          @db.Decimal(12, 3)
  unit_printed        String
  qty_kg              Decimal          @db.Decimal(12, 3)
  rate                Decimal          @db.Decimal(10, 2)
  rate_per_kg         Decimal          @db.Decimal(10, 2)
  discount            Decimal          @default(0) @db.Decimal(14, 2)
  taxable_amount      Decimal          @db.Decimal(14, 2)
  cgst_pct            Decimal          @default(0) @db.Decimal(5, 2)
  sgst_pct            Decimal          @default(0) @db.Decimal(5, 2)
  igst_pct            Decimal          @default(0) @db.Decimal(5, 2)
  cgst_amount         Decimal?         @db.Decimal(14, 2)
  sgst_amount         Decimal?         @db.Decimal(14, 2)
  igst_amount         Decimal?         @db.Decimal(14, 2)
  line_total          Decimal?         @db.Decimal(14, 2)

  movement            StockMovement?

  @@unique([purchase_invoice_id, line_no])
  @@index([product_id])
  @@map("purchase_invoice_items")
}

model PurchaseInvoiceRevision {
  id                  String          @id @default(cuid())
  purchase_invoice_id String
  purchase_invoice    PurchaseInvoice @relation(fields: [purchase_invoice_id], references: [id], onDelete: Cascade)
  version             Int
  snapshot            Json
  reason              String?
  created_at          DateTime        @default(now())

  @@unique([purchase_invoice_id, version])
  @@map("purchase_invoice_revisions")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

enum UploadJobStatus {
  QUEUED
  PROCESSING
  READY
  SAVED
  FAILED
  CANCELLED
}

model UploadJob {
  id                String          @id @default(cuid())
  file_name         String
  file_size         Int
  file_token        String
  file_hash         String
  status            UploadJobStatus @default(QUEUED)
  error             String?
  extracted_data    Json?
  saved_invoice_id  String?
  saved_invoice_num String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  @@index([status])
  @@index([created_at])
  @@map("upload_jobs")
}

// ==========================================
// ACCOUNT STATEMENTS (PARTY LEDGER) MODULE
// ==========================================

enum LedgerAccountType {
  CUSTOMER
  SUPPLIER
}

enum LedgerEntryType {
  OPENING
  SALE_INVOICE
  PURCHASE_INVOICE
  RECEIPT
  PAYMENT
  DEBIT_NOTE
  CREDIT_NOTE
  ADJUSTMENT
}

enum LedgerPaymentMode {
  CHEQUE
  NEFT
  RTGS
  UPI
  CASH
  OTHER
}

enum LedgerEntrySource {
  STATEMENT_IMPORT
  INVOICE_AUTO
  MANUAL
}

enum LedgerAllocationSource {
  MANUAL
  CONFIRMED_FROM_IMPORT
}

enum LedgerAuditAction {
  CREATE
  UPDATE
  VOID
  LINK
}

enum StatementParserType {
  TEXT_LAYOUT
  LLM
}

model LedgerAccount {
  id                     String            @id @default(cuid())
  account_type           LedgerAccountType
  is_informal            Boolean           @default(false)
  customer_id            String?           @unique
  customer               Customer?         @relation("CustomerRegularLedger", fields: [customer_id], references: [id], onDelete: Cascade)
  informal_customer_id   String?           @unique
  informal_customer      Customer?         @relation("CustomerInformalLedger", fields: [informal_customer_id], references: [id], onDelete: Cascade)
  supplier_id            String?           @unique
  supplier               Supplier?         @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  display_name           String
  credit_days            Int?              @default(90)
  statement_through_date DateTime?         @db.Date
  opening_balance_set    Boolean           @default(false)
  is_active              Boolean           @default(true)
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  entries                LedgerEntry[]
  import_batches         StatementImport[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id                   String             @id @default(cuid())
  account_id           String
  account              LedgerAccount      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  entry_date           DateTime           @db.Date
  sort_seq             Int                @default(0)
  entry_type           LedgerEntryType
  debit                Decimal            @default(0) @db.Decimal(14, 2)
  credit               Decimal            @default(0) @db.Decimal(14, 2)
  doc_no               String?
  doc_no_norm          String?
  invoice_id           String?            @unique
  invoice              Invoice?           @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  purchase_invoice_id  String?            @unique
  purchase_invoice     PurchaseInvoice?   @relation(fields: [purchase_invoice_id], references: [id], onDelete: SetNull)
  informal_invoice_id  String?            @unique
  informal_invoice     InformalInvoice?   @relation(fields: [informal_invoice_id], references: [id], onDelete: SetNull)
  payment_mode         LedgerPaymentMode?
  instrument_no        String?
  instrument_date      DateTime?          @db.Date
  referenced_docs      String[]           @default([])
  prior_year_refs      String[]           @default([])
  references_truncated Boolean            @default(false)
  particulars_raw      String?
  narration            String?
  source               LedgerEntrySource
  import_batch_id      String?
  import_batch         StatementImport?   @relation(fields: [import_batch_id], references: [id], onDelete: SetNull)
  needs_review         Boolean            @default(false)
  is_void              Boolean            @default(false)
  void_reason          String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  settling_allocations LedgerAllocation[] @relation("SettlingEntry")
  target_allocations   LedgerAllocation[] @relation("TargetEntry")
  audits               LedgerAudit[]

  @@index([account_id, entry_date, sort_seq, id])
  @@index([entry_type])
  @@map("ledger_entries")
}

model LedgerAllocation {
  id                String                 @id @default(cuid())
  settling_entry_id String
  settling_entry    LedgerEntry            @relation("SettlingEntry", fields: [settling_entry_id], references: [id], onDelete: Cascade)
  target_entry_id   String
  target_entry      LedgerEntry            @relation("TargetEntry", fields: [target_entry_id], references: [id], onDelete: Cascade)
  amount            Decimal                @db.Decimal(14, 2)
  source            LedgerAllocationSource
  created_at        DateTime               @default(now())

  @@map("ledger_allocations")
}

model LedgerAudit {
  id       String            @id @default(cuid())
  entry_id String
  entry    LedgerEntry       @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  action   LedgerAuditAction
  before   Json?
  after    Json?
  reason   String?
  at       DateTime          @default(now())

  @@map("ledger_audit")
}

model StatementImport {
  id             String              @id @default(cuid())
  account_id     String
  account        LedgerAccount       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  file_hash      String
  file_name      String
  period_from    DateTime            @db.Date
  period_to      DateTime            @db.Date
  parser         StatementParserType
  entries_added  Int                 @default(0)
  entries_linked Int                 @default(0)
  warnings       Json?
  created_at     DateTime            @default(now())

  entries        LedgerEntry[]

  @@unique([account_id, file_hash])
  @@map("statement_imports")
}

// ==========================================
// INFORMAL INVOICES MODULE (NON-GST)
// ==========================================

model InformalInvoice {
  id                     String                @id @default(cuid())
  invoice_number         String
  invoice_number_norm    String                @unique
  invoice_date           DateTime              @db.Date
  financial_year         String
  customer_id            String?
  customer               Customer?             @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  customer_name_snapshot String
  total_amount           Decimal               @db.Decimal(14, 2)
  notes                  String?
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  items                  InformalInvoiceItem[]
  ledger_entry           LedgerEntry?

  @@index([invoice_date])
  @@index([customer_id, invoice_date])
  @@index([financial_year])
  @@map("informal_invoices")
}

model InformalInvoiceItem {
  id                  String          @id @default(cuid())
  informal_invoice_id String
  informal_invoice    InformalInvoice @relation(fields: [informal_invoice_id], references: [id], onDelete: Cascade)
  line_no             Int
  product_id          String?
  product             Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name_raw    String
  qty_kg              Decimal         @db.Decimal(12, 3)
  rate                Decimal         @db.Decimal(10, 2)
  amount              Decimal         @db.Decimal(14, 2)

  movement            StockMovement?

  @@unique([informal_invoice_id, line_no])
  @@index([product_id])
  @@map("informal_invoice_items")
}

